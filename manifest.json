{
  "manifest_version": 3,
  "name": "__MSG_extension_name__",
  "version": "1.0.8",
  "description": "__MSG_extension_description__",
  "default_locale": "en",
  "permissions": ["contextMenus", "scripting"],
  "host_permissions": ["*://*.netflix.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.netflix.com/*"],
      "js": ["content.js"],
      "css": ["style.css"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}